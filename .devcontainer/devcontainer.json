{
  "name": "Market Game · Flutter",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter phone preview",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.tools/flutter/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": { "dart.flutterSdkPath": ".tools/flutter" }
    }
  },
  "postCreateCommand": "bash tool/setup.sh"
}
